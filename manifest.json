{
  "manifest_version": 3,
  "minimum_chrome_version": "135",
  "name": "Anand Chrome Tools",
  "version": "0.3.0",
  "description": "Small personal browser automations and shortcuts.",
  "permissions": ["alarms", "bookmarks", "scripting", "storage", "tabGroups", "tabs", "unlimitedStorage", "userScripts"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://calendar.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://claude.com/*"
      ],
      "js": ["palette-core.js", "annotations.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "commands": {
    "open-command-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Open Command Palette"
    },
    "new-tab-right": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period"
      },
      "description": "Open New Tab to the Right"
    },
    "annotate": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Annotate the hovered or open item"
    }
  }
}

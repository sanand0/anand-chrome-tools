{
  "manifest_version": 3,
  "minimum_chrome_version": "135",
  "name": "Anand Chrome Tools",
  "version": "0.2.0",
  "description": "Small personal browser automations and shortcuts.",
  "permissions": ["bookmarks", "scripting", "storage", "tabGroups", "tabs", "userScripts"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "commands": {
    "open-command-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Open Command Palette"
    },
    "new-tab-right": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period"
      },
      "description": "Open New Tab to the Right"
    }
  }
}
